{
  "manifest_version": 3,
  "name": "Harbor",
  "version": "0.1.0",
  "description": "Send downloads to Harbor.",
  "key": "",
  "permissions": ["contextMenus", "downloads", "nativeMessaging", "cookies", "storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Harbor" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
