{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harbor",
  "version": "1.0.0",
  "identifier": "com.harbor.download",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build && sh scripts/stage-agent.sh"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Harbor",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/harbor-agent"],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
